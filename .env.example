# Spring Profiles
SPRING_PROFILES_ACTIVE=dev

# Application Server
SERVER_PORT=8080

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_EXAMPLE_TASKMANAGER=DEBUG
